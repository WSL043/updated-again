{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Updated Again",
  "version": "0.1.1-1",
  "identifier": "com.wsl043.updatedagain",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Updated Again · 又更了",
        "width": 1240,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://wsl043.github.io https://github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "A living software toy that updates every day.",
    "longDescription": "Updated Again is a software toy where every update has a reason and a real, reversible effect.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4MDQ0MkQ2QzI0QkIwQjUKUldTMXNFdkMxa0lFU0FOaSs3QWdCeHFWYVJhaEFxZ2t1Nm1HMzc3bjZsbVdvU2hIUGNENkRjRFkK",
      "endpoints": [
        "https://wsl043.github.io/updated-again/feed/core-latest.json"
      ],
      "dialog": false
    }
  }
}
