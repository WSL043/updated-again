# Public verification key. Safe to commit; never put the private signing key here.
VITE_CAPSULE_PUBLIC_KEY=
VITE_UPDATE_BASE_URL=http://localhost:1420/

# CI-only secrets used by scripts/run-daily-update.mjs:
# CAPSULE_SIGNING_PRIVATE_KEY=<base64 32-byte Ed25519 private key>
# CHAOS_SEED=<private randomness salt>
